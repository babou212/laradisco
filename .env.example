APP_NAME=Laradisco
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
ARGON_MEMORY=131072
ARGON_THREADS=2
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laradisco
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

REVERB_APP_ID=laradisco
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=https

# Backend/queue worker should connect to Reverb on localhost
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=6001

# Reverb server bind address
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001

# Enable Redis scaling for multi-pod Reverb deployment
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# To send mail via Resend, set MAIL_MAILER=resend and provide an API key.
RESEND_API_KEY=

MEDIA_DISK=s3
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=15
MEDIA_QUEUE_CONNECTION=redis
MEDIA_QUEUE=media

# Object storage (S3-compatible, path-style required).
# Production: Hetzner Object Storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fsn1
AWS_BUCKET=
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# Local dev: the `garage` compose service provides S3. Use instead:
#   AWS_ACCESS_KEY_ID=GK3d1f0c9a8b7e6d5c4b3a2f10
#   AWS_SECRET_ACCESS_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
#   AWS_DEFAULT_REGION=garage
#   AWS_BUCKET=laradisco
#   AWS_ENDPOINT=http://garage:3900
#   # Presigned URLs are signed with this host-reachable endpoint so the client
#   # can fetch attachments; backend I/O uses AWS_ENDPOINT above. Prod: leave unset.
#   AWS_PUBLIC_ENDPOINT=http://localhost:3900

# Production: point to your LiveKit server and generate your own key/secret pair.
# Local dev with docker-compose: use the values below (they match compose.yaml defaults).
# NOTE: LIVEKIT_API_SECRET must be at least 32 characters (HS256 minimum).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devkey-secret-livekit-32chars-ok!

HORIZON_ALLOWED_EMAILS=

CORS_ALLOWED_ORIGINS=*

OCTANE_HTTPS=true

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

APP_USER=www-data

FORWARD_REDIS_PORT=6379
FORWARD_REVERB_PORT=8080
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKeyForLocalDev
